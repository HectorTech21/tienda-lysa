{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tienda-lysa",
  // Cuenta de Cloudflare de la tienda: wrangler despliega siempre en ella.
  "account_id": "907db136813ed4ab7d8a9d2a64157397",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",

  // La web solo se sirve desde el dominio propio: sin dirección *.workers.dev
  // ni direcciones de vista previa por versión.
  "workers_dev": false,
  "preview_urls": false,

  // Dominio principal: tiendalysa43.com (sin www). www.tiendalysa43.com redirige aquí con una
  // regla de redirección de Cloudflare (ver «Dominio y SEO» en AGENTS.md); si www
  // llegara al Worker, src/index.js también lo redirige.
  // TODO (Cloudflare): el dominio tiene que estar ya añadido a la cuenta antes de desplegar.
  "routes": [
    { "pattern": "tiendalysa43.com", "custom_domain": true }
  ],

  // Solo afecta a "wrangler dev": sin esto, el desarrollo local se presentaría como
  // tiendalysa43.com y el panel respondería 401 (el salto de .dev.vars exige un equipo local).
  "dev": { "host": "localhost" },

  // Web pública y panel: archivos estáticos de public/.
  // TODAS las peticiones pasan primero por el Worker (run_worker_first: true), que normaliza
  // la ruta y exige la sesión en el panel y su API antes de servir nada (también //admin,
  // /ADMIN, /%61dmin…). No poner aquí una lista de rutas ni excepciones: con una excepción
  // como /assets/*, una ruta del tipo /assets/%2e%2e/admin/ podría saltarse el Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tienda-lysa",
      // TODO (Cloudflare): sustituir por el database_id real que devuelve
      // "npx wrangler d1 create tienda-lysa".
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      // TODO (Cloudflare): crear el bucket con "npx wrangler r2 bucket create tienda-lysa-imagenes"
      // o cambiar este nombre por el del bucket real.
      "bucket_name": "tienda-lysa-imagenes"
    }
  ],

  "vars": {
    // Dominio del equipo de Cloudflare Access de la tienda.
    "ACCESS_TEAM_DOMAIN": "tiendalysa.cloudflareaccess.com",
    // TODO (Cloudflare Access): etiqueta AUD de la aplicación de Access que protege /admin y /api/admin.
    "ACCESS_AUD": ""
    // DEV_BYPASS_AUTH no se define NUNCA aquí: solo en .dev.vars (local, fuera de git).
  }
}
